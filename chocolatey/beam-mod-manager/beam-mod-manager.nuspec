  <metadata>
    <id>beam-mod-manager</id>
    <version>0.9.8</version>
    <title>Beam Mod Manager</title>
    <authors>NickTheGrizzly</authors>
    <owners>NickTheGrizzly</owners>
    <projectUrl>https://beammodmanager.com/</projectUrl>
    <iconUrl>https://beammodmanager.com/pad/bmm-icon-256.png</iconUrl>
